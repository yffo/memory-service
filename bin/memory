export const USAGE = `tabellio — 显式记忆服务（M1 + M2：读取回执 / 巩固 / 撤销）

用法：
  tabellio status [--store DIR] [--rebuild-index] [--json]
  tabellio index  [--store DIR] [--rebuild] [--json]             # 索引层体检（默认只读）
  tabellio search --query "<词>" [--budget-tokens N] [--kinds a,b] [--trusts a,b]
                 [--min-relevance F] [--min-score F] [--min-coverage F] [--ledger] [--json]
  tabellio read   --id <ulid|notes/ulid.md> [--ledger] [--json]
  tabellio remember --file <path.md> [--dry] [--json]
                   [--kind k] [--trust t] [--scope s] [--tags a,b] [--id ULID]
  tabellio capture  --file <path.md|-> [--source REF] [--kind k] [--tags a,b] [--dry] [--json]
  tabellio inbox    [--accept <id[,id]>]... [--reject <id[,id]>]... [--dry] [--json]  # 候选和自动巩固提案都能批

  tabellio setup    [--host claude,cursor,codex|all] [--write] [--verify] [--force] [--read-only] [--json]
  tabellio hook install   --host claude [--session-start] [--auto-consolidate] [--write] [--force] [--json]  # 默认只装 SessionEnd
  tabellio hook uninstall --host claude [--write] [--json]
  tabellio hook claude-session-end [--json] [--auto-consolidate]  # 内部：只写候选/提案
  tabellio hook claude-session-start [--json]        # 内部：宿主 SessionStart 调用，只提示待批准
  tabellio schedule install   [--interval 6h] [--write] [--force] [--json]  # macOS launchd 定时发现，只产提案
  tabellio schedule uninstall [--write] [--json]
  tabellio schedule status    [--json]                # 文件在不在、launchd 里有没有加载
  tabellio import --from <旧 Engramory 库目录> [--dry] [--json]
  tabellio recall --query "<词>" [--receipt|--save-receipt] [--budget-tokens N] [--json]
  tabellio explain (--query "<词>" | --receipt <id|path>) [--json]
  tabellio verify --receipt <id|path> [--json]
  tabellio consolidate [--dry-run|--apply] [--max-change-ratio F] [--scope S] [--kinds a,b]
                    [--archive <id[,id]>]... [--json]
  tabellio consolidate --auto [--write] [--min-similarity F] [--max-proposals N] [--json]  # 只写待确认提案，不改笔记
  tabellio consolidate --merge <id[,id]>... [--apply] [--json]       # 默认只出提案
  tabellio consolidate --summarize <id> [--apply] [--json]            # 默认只出提案
  tabellio consolidate --promote <id[,id]>... [--apply] [--json]      # 只写候选，不关源
  tabellio consolidate --undo <run|path> [--json]
  tabellio help | --help | -h | --version

全局：
  --store DIR    库目录（默认 $MEMORY_STORE / $TABELLIO_STORE，否则 ~/memory/tabellio）
  --json         机器可读输出（形状见 docs/07-usage.md）
  --ledger       把这次只读操作记进账本（默认不写）

退出码：0 成功 / 1 判定拒绝或回执、巩固失败 / 2 用法错误`;

/** 解析 argv（`--k v`、`--k=v`、`--flag`）。不认识的位置参数进 `_`。 */
export function parseArgs(argv) {
  const out = { _: [] };
  for (let i = 0; i < argv.length; i += 1) {
    const token = argv[i];
    if (token === '--') {
      out._.push(...argv.slice(i + 1));
      break;
    }
    if (!token.startsWith('-')) {
      out._.push(token);
      continue;
    }
    const body = token.replace(/^--?/, '');
    const eq = body.indexOf('=');
    if (eq >= 0) {
      out[body.slice(0, eq)] = body.slice(eq + 1);
      continue;
    }
    const next = argv[i + 1];
    if (next !== undefined && !next.startsWith('--')) {
      out[body] = next;
      i += 1;
    } else {
      out[body] = true;
    }
  }
  return out;
}

function listArg(value) {
  if (value === undefined || value === true || value === null) return undefined;
  const parts = String(value)
    .split(',')
    .map((s) => s.trim())
    .filter(Boolean);
  return parts.length ? parts : undefined;
}

function recallOptionsFromArgs(args) {
  return {
    budgetTokens: numArg(args['budget-tokens'], undefined),
    kinds: listArg(args.kinds),
    trusts: listArg(args.trusts),
    minRelevance: numArg(args['min-relevance'], undefined),
    minCoverage: numArg(args['min-coverage'], undefined),
    minScore: numArg(args['min-score'], undefined),
    includeCore: args['no-core'] ? false : true,
    ledger: Boolean(args.ledger),
  };
}

/** 收集可重复的 `--archive`；逗号分隔与重复出现都接受。 */
function flagArgValues(argv, args, name) {
  const raw = [];
  const flag = `--${name}`;
  for (let i = 0; i < argv.length; i += 1) {
    const token = argv[i];
    if (token === '--') break;
    if (token === flag) {
      const next = argv[i + 1];
      if (next !== undefined && !next.startsWith('--')) {
        raw.push(next);
        i += 1;
      } else {
        raw.push(true);
      }
    } else if (token.startsWith(`${flag}=`)) {
      raw.push(token.slice(flag.length + 1));
    }
  }
  if (raw.length === 0) {
    if (args[name] === undefined) return { provided: false, invalid: false, values: [] };
    raw.push(args[name]);
  }
  if (raw.some((item) => item === true || String(item).trim() === '')) return { provided: true, invalid: true, values: [] };
  const values = [];
  const seen = new Set();
  for (const item of raw) {
    for (const part of String(item).split(',')) {
      const id = part.trim();
      if (!id || seen.has(id)) continue;
      seen.add(id);
      values.push(id);
    }
  }
  return { provided: true, invalid: false, values };
}

function archiveArgValues(argv, args) {
  return flagArgValues(argv, args, 'archive');
}

function numArg(value, dflt) {
  // 复用 core 的那一份收敛逻辑（一个算法只能有一处实现）：
  // 它把 null / '' / 布尔 都判成「没给」。这里额外的 `true` 分支是因为
  // `--min-coverage` 后面漏了值时，parseArgs 会把 `true` 放进 args 里，
  // 而 `Number(true) === 1` —— 那会变成一个**比默认还严**的阈值，
  // 症状是「命令行少打个数字，检索突然什么都搜不到」。
  if (value === true) return dflt;
  return finiteOr(value, dflt);
}

/** 人类可读渲染。只读数据，不产生副作用。 */
function humanStatus(s) {
  const lines = [
    `库：${s.store}`,
    `笔记：${s.notes} 条（core ${s.coreNotes}）  |  索引：${s.indexLines} 行 / ${s.indexBytes} 字节（上限 ${s.caps.indexLines} 行 / ${s.caps.indexBytes} 字节）`,
    `单条上限：${s.caps.noteChars} 字 / ${s.caps.noteTokens} token  |  库上限：${s.caps.notes} 条`,
    `候选（notes/candidates）：${s.candidates}  |  账本：${s.ledgerEntries} 条事件${s.ledgerMalformed ? `（坏行 ${s.ledgerMalformed}）` : ''}`,
    `解析失败：${s.parseFailures}  |  超长：${s.oversizeChars} 条超 ${s.caps.noteChars} 字、${s.oversizeTokens} 条超 ${s.caps.noteTokens} token`,
  ];
  if (s.failures.length) {
    lines.push('解析失败明细：');
    for (const f of s.failures.slice(0, 20)) lines.push(`  - ${f.id || f.path}：${f.codes.join(',')}`);
    if (s.failures.length > 20) lines.push(`  … 还有 ${s.failures.length - 20} 条（--json 看全部）`);
  }
  for (const w of s.warnings) lines.push(`⚠️  ${w}`);
  return lines.join('\n');
}

function humanSearch(r) {
  if (r.hits.length === 0) {
    const why = r.reason ? `（${r.reason}）` : '';
    return `没有命中${why}：库内证据不足以回答，这是**正常返回**，不是错误。`;
  }
  const rows = r.hits.map((h, i) => `${String(i + 1).padStart(2)}. ${h.score.toFixed(3)}  ${h.title ?? ''}  [${h.id}]`);
  return [`${r.hits.length} 条命中，约 ${r.tokens} token：`, ...rows].join('\n');
}

function humanRecall(r) {
  const head = r.refused
    ? `拒答（${r.reason}）：没有达到门槛的证据。最近的是：`
    : `${r.items.length} 条（${r.tokens} token，pull ${r.split.pull} / push ${r.split.push}${r.truncated ? '，已截断' : ''}）：`;
  const lines = [head];
  for (const it of r.items) lines.push(`  - ${it.title ?? it.id} [${it.id}] ${it.why ?? ''}`);
  for (const n of r.nearest ?? []) lines.push(`  · 候选：${n.id}（score ${n.score}）${n.why ?? ''}`);
  if (r.droppedCount) lines.push(`  （因预算丢掉 ${r.droppedCount} 条：${r.dropped.map((d) => d.reason).join(',')}）`);
  if (r.receipt) {
    lines.push(`回执：${r.receipt.receiptId}${r.receiptPath ? ` → ${r.receiptPath}` : '（未落盘）'}`);
    if (r.receiptError) lines.push(`⚠️  回执未保存：${r.receiptError.code} ${r.receiptError.message}`);
  }
  return lines.join('\n');
}

function humanExplain(r) {
  if (!r.ok) return `无法解释：${r.error?.code ?? r.status} ${r.error?.message ?? ''}`.trim();
  const ex = r.explanation;
  const head = r.decision?.refused
    ? `拒答（${r.decision.reason}）；回执 ${r.receiptId}（${r.mode === 'query' ? '现场生成，未落盘' : r.receiptPath}）`
    : `纳入 ${ex.summary.recalled} 条；回执 ${r.receiptId}（${r.mode === 'query' ? '现场生成，未落盘' : r.receiptPath}）`;
  const lines = [head, `查询：${r.query}`];
  for (const item of ex.recalled) {
    const total = typeof item.score === 'object' && item.score ? item.score.total : item.score;
    const shown = typeof total === 'number' ? total.toFixed(3) : (total ?? '');
    lines.push(`  ✓ ${item.title || item.id} [${item.id}] via=${item.via} score=${shown} ${item.why ?? ''}`);
  }
  if (ex.notRecalled.length) {
    lines.push(`未纳入 ${ex.summary.ignoredTotal} 条${ex.summary.ignoredTruncated ? '（回执只留前 100）' : ''}：`);
    for (const item of ex.notRecalled.slice(0, 10)) lines.push(`  · ${item.id}  score=${item.score ?? '-'} rel=${item.relevance ?? '-'} cov=${item.coverage ?? '-'}  ${item.reason}`);
    if (ex.notRecalled.length > 10) lines.push(`  … 还有 ${ex.notRecalled.length - 10} 条`);
  }
  if (ex.dropped.length) {
    lines.push(`因预算丢弃 ${ex.summary.dropped} 条：`);
    for (const item of ex.dropped.slice(0, 10)) lines.push(`  · ${item.title || item.id} [${item.id}] ${item.reason}${item.hard ? '（硬闸门）' : ''}`);
  }
  for (const item of ex.nearest) lines.push(`  · 最近候选：${item.id} score=${item.score} ${item.why ?? ''}`);
  const v = r.verification;
  lines.push(`核验：${v.status}${v.changed?.length ? `，正文/元数据漂移 ${v.changed.length} 条` : ''}${v.missing?.length ? `，缺失 ${v.missing.length} 条` : ''}`);
  return lines.join('\n');
}

function humanVerify(r) {
  if (r.status === 'unreadable') return `无法核验：${r.error?.code ?? 'E_RECEIPT'} ${r.error?.message ?? ''}`.trim();
  const head = r.status === 'verified'
    ? '✅ 回执核验通过（回执未被改，笔记正文与元数据一致）'
    : r.status === 'tampered'
      ? '❌ 回执被篡改（回执自身 hash 对不上）'
      : `⚠️  回执与当前笔记不一致（${r.status}）`;
  const lines = [head, `回执：${r.receiptId}`, `检查 ${r.checked} 条（纳入 ${r.itemsChecked} / 最近候选 ${r.nearestChecked}），一致 ${r.matched} 条`];
  for (const item of r.changed ?? []) lines.push(`  ~ ${item.id}（${item.role}）：${item.fields.join(',')} 变了`);
  for (const item of r.missing ?? []) lines.push(`  - ${item.id}（${item.role}）：已不在库里`);
  for (const problem of r.problems ?? []) lines.push(`  ! ${problem.code}${problem.message ? `：${problem.message}` : ''}`);
  if (r.storeMismatch) lines.push(`⚠️  回执记录的库路径与当前库不同：${r.receiptStore}`);
  return lines.join('\n');
}

function humanProposal(r) {
  if (!r.ok) {
    const head = `提案被拒（${r.reason}）：没有写任何文件`;
    const lines = [head];
    if (r.mode) lines.push(`模式：${r.mode}`);
    for (const s of r.skipped ?? []) lines.push(`  · 跳过 ${s.id}：${s.reason}`);
    return lines.join('\n');
  }
  const s = r.stats;
  const lines = [
    `[提案] ${r.mode_label}：${s.sources} 条源 → 1 条目标（dry-run，未写库）`,
    `提案：${r.proposal_id}`,
    `目标：${r.target.path}（status=draft，需人工确认）`,
    `草稿：${s.target_chars} 字 / ${s.target_tokens} token；源：${s.source_chars} 字 / ${s.source_tokens} token`,
    `预计：${s.saved_tokens >= 0 ? '省' : '多'} ${Math.abs(s.saved_tokens)} token（源 ${s.source_chars} 字 → 目标 ${s.target_chars} 字），预计写 ${s.estimated_write_ops} 次`,
    '来源：',
  ];
  for (const source of r.sources) {
    lines.push(`  - [${source.id}] ${source.title}（${source.kind}/${source.scope}，${source.chars} 字）`);
  }
  for (const warning of r.warnings ?? []) lines.push(`  ⚠️  ${warning.message}`);
  lines.push('--- 草稿预览 ---');
  lines.push(r.target.body.trimEnd());
  lines.push('--- 预览结束 ---');
  lines.push(`下一步：${r.next_action}`);
  return lines.join('\n');
}


function humanContentApply(r) {
  if (!r.ok) {
    const lines = [`内容类巩固中止（${r.reason}）：没有写入目标笔记`];
    if (r.mode) lines.push(`模式：${r.mode}`);
    if (r.run_id) lines.push(`run：${r.run_id}`);
    if (r.source_id) lines.push(`源：${r.source_id}（${r.detail ?? 'changed'}）`);
    if (r.failure) lines.push(`失败：${r.failure.id} ${r.failure.reason}`);
    if (r.rolled_back !== undefined) lines.push(`回滚：${r.rolled_back ? '已回滚（目标已删除，源已恢复）' : '回滚不完整（需要人工检查）'}`);
    if (r.error?.message) lines.push(`错误：${r.error.code ?? ''} ${r.error.message}`);
    return lines.join('\n');
  }
  const s = r.stats;
  const lines = [
    `已应用${r.mode === 'promote' ? '候选' : '内容巩固'}：目标 ${r.target.id}（${r.target.status}）`,
    `run：${r.run_id}`,
    `目标：${r.target.path}（${r.target.chars} 字 / ${r.target.tokens} token）`,
  ];
  if (r.mode === 'promote') lines.push('源未关闭：候选规则尚未批准，原事实仍然有效。');
  else lines.push(`源已关闭：${r.sources.length} 条（valid_to + superseded_by）`);
  if (r.plan_path) lines.push(`计划：${r.plan_path}`);
  if (r.receipt_path) lines.push(`回执：${r.receipt_path}（可 ` + 'consolidate --undo' + ` 撤销）`);
  lines.push(`预计省：${s.saved_tokens >= 0 ? '省' : '多'} ${Math.abs(s.saved_tokens)} token`);
  return lines.join('\n');
}

function humanConsolidate(r) {
  if (r.status === 'aborted') {
    const lines = [`巩固中止（${r.reason}）：计划 ${r.operations?.length ?? 0} 条，未改任何笔记`];
    if (r.run_id) lines.push(`run：${r.run_id}`);
    if (r.plan_path) lines.push(`计划：${r.plan_path}`);
    if (r.rolled_back !== undefined) lines.push(`回滚：${r.rolled_back ? '已回滚' : '回滚失败（需要人工检查）'}`);
    if (r.error?.message) lines.push(`错误：${r.error.code ?? ''} ${r.error.message}`);
    return lines.join('\n');
  }
  const dry = r.dry_run !== false;
  const head = dry
    ? `[dry-run] 计划 ${r.operations.length} 条（扫描 ${r.stats.scanned} 条，允许改动 ${r.stats.allowed} 条，改动率 ${(r.stats.change_ratio * 100).toFixed(1)}%）`
    : `已应用 ${r.applied} 条，跳过 ${r.skipped} 条（扫描 ${r.stats.scanned} 条，改动率 ${(r.stats.change_ratio * 100).toFixed(1)}%）`;
  const lines = [head, `run：${r.run_id}`];
  for (const op of r.operations) {
    if (op.op === 'archive') lines.push(`  - archive ${op.id}（status=archived）`);
    else lines.push(`  - invalidate ${op.id} → ${op.superseded_by}（valid_to=${(op.valid_to ?? '').slice(0, 19)}）`);
  }
  for (const s of (r.skipped_detail ?? []).slice(0, 20)) {
    if (typeof s === 'object') lines.push(`  · 跳过 ${s.id}：${s.reason}`);
  }
  if (r.plan_path) lines.push(`计划：${r.plan_path}`);
  if (r.receipt_path) lines.push(`回执：${r.receipt_path}（可 ` + 'consolidate --undo' + ` 撤销）`);
  return lines.join('\n');
}

function humanUndo(r) {
  if (r.status === 'conflict') {
    const lines = ['撤销被拒（整单冲突，未改任何笔记）', `run：${r.run_id}`];
    for (const c of r.conflicts ?? []) lines.push(`  - ${c.id}：${c.reason}`);
    return lines.join('\n');
  }
  if (r.status === 'tampered') {
    return [`撤销被拒：巩固回执被篡改`, `run：${r.run_id}`, ...(r.problems ?? []).map((p) => `  ! ${p.code}${p.message ? `：${p.message}` : ''}`)].join('\n');
  }
  if (!r.ok) return `撤销失败（${r.status}）：${r.error?.code ?? ''} ${r.error?.message ?? ''}`.trim();
  const head = r.status === 'already_undone'
    ? '这次巩固已经撤销过，没有需要恢复的笔记'
    : `已撤销：恢复 ${r.restored} 条源，跳过 ${r.skipped} 条${r.target_deleted ? '；目标笔记已删除' : ''}`;
  const lines = [head, `run：${r.run_id}`];
  if (r.undo_path) lines.push(`撤销记录：${r.undo_path}`);
  return lines.join('\n');
}

function humanIndex(r) {
  const head = r.exists
    ? `索引：${r.lines} 行 / ${r.bytes} 字节（上限 ${r.caps.lines} 行 / ${r.caps.bytes} 字节）  |  层级 ${r.levels}（路由 + 清单）`
    : '索引还没生成（跑 `tabellio index --rebuild`）';
  const lines = [
    `库：${r.store}`,
    head,
    `路由：${r.routes.length} 组  |  清单文件：${r.listFiles.length} 个  |  笔记：${r.notes} 条`,
    `列出的条数：${r.listed}/${r.notes}（走得到 ${r.reachable}）${r.hidden ? `  |  没路可走：${r.unreachableCount}` : ''}`,
  ];
  if (r.routes.length) {
    lines.push('大组（前 10）：');
    for (const g of [...r.routes].sort((a, b) => b.count - a.count).slice(0, 10)) {
      lines.push(`  - ${g.name}  ${g.count} 条  → index/${g.rel}`);
    }
  }
  if (r.unreachableCount) {
    lines.push(`走不到的笔记（前 5）：${r.unreachable.slice(0, 5).join('、')}`);
  }
  for (const w of r.warnings) lines.push(`⚠️  ${w}`);
  return lines.join('\n');
}

function emit(payload, { json, human }) {
  if (json) process.stdout.write(`${JSON.stringify(payload)}\n`);
  else process.stdout.write(`${human ?? JSON.stringify(payload, null, 2)}\n`);
}

/**
 * 跑一条命令。
 *
 * @returns {Promise<number>} 退出码
 */
export async function main(argv, io = {}) {
  const out = io.stdout ?? process.stdout;
  const err = io.stderr ?? process.stderr;
  const args = parseArgs(argv);
  const json = Boolean(args.json);
  const command = args._[0] ?? (args.help || args.h ? 'help' : 'status');

  if (command === 'help' || args.help || args.h) {
    out.write(`${USAGE}\n`);
    return 0;
  }
  if (args.version || args.V) {
    out.write(`${VERSION}\n`);
    return 0;
  }
  if (!['status', 'index', 'search', 'read', 'remember', 'capture', 'inbox', 'setup', 'hook', 'schedule', 'import', 'recall', 'explain', 'verify', 'consolidate', 'paths'].includes(command)) {
    err.write(`未知命令：${command}\n\n${USAGE}\n`);
    return 2;
  }

  const storePath = args.store ? resolve(String(args.store)) : defaultStorePath();
  const ctx = openStore(storePath);

  try {
    switch (command) {
      case 'paths': {
        emit({ store: ctx.store, ...ctx.paths }, { json, human: Object.entries({ store: ctx.store, ...ctx.paths }).map(([k, v]) => `${k}: ${v}`).join('\n') });
        return 0;
      }
      case 'status': {
        ctx.ensure();
        const s = status(ctx, { rebuildIndex: Boolean(args['rebuild-index'] ?? args.rebuildIndex) });
        emit(s, { json, human: humanStatus(s) });
        // 库不健康（有解析失败）时用 1 退出，让脚本/CI 能发现。
        return s.parseFailures > 0 ? 1 : 0;
      }
      case 'index': {
        const r = indexReport(ctx, { rebuild: Boolean(args.rebuild ?? args['rebuild-index']) });
        emit(r, { json, human: humanIndex(r) });
        // 有笔记从索引走不到 = 索引这条路还有盲区，用 1 退出让脚本/CI 能发现。
        return r.unreachableCount > 0 || r.missingFiles.length > 0 ? 1 : 0;
      }
      case 'search': {
        // 参数校验**必须先做**：先查「库存在吗」的话，`tabellio search`（忘了 --query）
        // 在一个空库上会返回 `{refused:true, reason:'store_empty'}` 且退出码 0 ——
        // 脚本里 `tabellio search --query "$Q" || exit 1` 这种写法会静默通过一个用错的命令。
        // 用错了就是退出码 2，和「检索结果为空」是两回事。
        const query = args.query ?? args.q ?? args._.slice(1).join(' ');
        if (!query || !String(query).trim()) {
          err.write('search 需要 --query "<词>"\n');
          return 2;
        }
        if (!ctx.exists()) {
          const empty = { hits: [], tokens: 0, refused: true, reason: 'store_empty', diagnostics: { store: ctx.store, notes: 0 } };
          emit(empty, { json, human: `库还不存在（${ctx.store}），没有可检索的内容。` });
          return 0;
        }
        const r = search(ctx, query, {
          budgetTokens: numArg(args['budget-tokens'] ?? args.budgetTokens, undefined),
          kinds: listArg(args.kinds),
          trusts: listArg(args.trusts),
          scope: args.scope,
          minRelevance: numArg(args['min-relevance'], undefined),
          minCoverage: numArg(args['min-coverage'], undefined),
          minScore: numArg(args['min-score'], undefined),
          includeCore: args['no-core'] ? false : true,
          ledger: Boolean(args.ledger),
        });
        const { diagnostics, ...frozen } = r;
        // `--costs` 是评测专用口：默认契约仍是 {hits,tokens,refused,reason}，
        // 只有显式要成本时才附上「每条命中各自的预算成本」。
        const payload = json && args.costs ? { ...frozen, costs: diagnostics?.hitCosts ?? [] } : json ? frozen : r;
        emit(payload, { json, human: humanSearch(r) });
        return 0;
      }
      case 'recall': {
        const query = args.query ?? args.q ?? args._.slice(1).join(' ');
        if (!query || !String(query).trim()) {
          err.write('recall 需要 --query "<词>"\n');
          return 2;
        }
        const r = recallQuery(ctx, query, {
          ...recallOptionsFromArgs(args),
          // `--receipt` 只附带回执；`--save-receipt` 才落 runs/。两个都给时以落盘为准。
          receipt: Boolean(args.receipt || args['save-receipt']),
          saveReceipt: Boolean(args['save-receipt']),
        });
        emit(r, { json, human: humanRecall(r) });
        // 拒答是正常回答，但 --save-receipt 落盘失败是实打实的失败，不能退 0。
        return r.refused || r.receiptError ? 1 : 0;
      }
      case 'explain': {
        const query = args.query ?? args.q ?? args._.slice(1).join(' ');
        const receiptRef = typeof args.receipt === 'string' ? args.receipt : null;
        const hasQuery = Boolean(query && String(query).trim());
        if (hasQuery === Boolean(receiptRef)) {
          err.write('explain 需要且只需要 --query "<词>" 或 --receipt <id|path> 之一\n');
          return 2;
        }
        const r = explainRecall(ctx, {
          query: hasQuery ? String(query) : null,
          receiptRef,
          // explain 必须只读：即使调用方顺手带了 --ledger，也不写账本。
          options: { ...recallOptionsFromArgs(args), ledger: false },
        });
        emit(r, { json, human: humanExplain(r) });
        return r.ok ? 0 : 1;
      }
      case 'verify': {
        const receiptRef = typeof args.receipt === 'string' ? args.receipt : (args._[1] ?? null);
        if (!receiptRef) {
          err.write('verify 需要 --receipt <id|path>\n');
          return 2;
        }
        const r = verifyRecallReceipt(ctx, receiptRef);
        emit(r, { json, human: humanVerify(r) });
        // 只有 verified 才算成功；tampered / drifted / unreadable 都是 1。
        return r.ok ? 0 : 1;
      }
      case 'consolidate': {
        const apply = Boolean(args.apply);
        let maxChangeRatio = 0.05;
        if (args['max-change-ratio'] !== undefined) {
          const n = numArg(args['max-change-ratio'], NaN);
          if (!Number.isFinite(n) || n < 0 || n > 1) {
            err.write('consolidate --max-change-ratio 需要 0 到 1 之间的数（默认 0.05）\n');
            return 2;
          }
          maxChangeRatio = n;
        }
        if (args.apply && args['dry-run']) {
          err.write('consolidate 的 --apply 和 --dry-run 只能选一个\n');
          return 2;
        }
        if (args.auto) {
          if (
            args.apply ||
            args['dry-run'] ||
            args.merge !== undefined ||
            args.summarize !== undefined ||
            args.promote !== undefined ||
            args.archive !== undefined ||
            args.undo !== undefined ||
            args.scope !== undefined ||
            args.kinds !== undefined
          ) {
            err.write('consolidate --auto 不能和 --apply/--dry-run/--merge/--summarize/--promote/--archive/--undo/--scope/--kinds 同时用\n');
            return 2;
          }
          let minSimilarity;
          if (args['min-similarity'] !== undefined) {
            const n = numArg(args['min-similarity'], NaN);
            if (!Number.isFinite(n) || n < 0 || n > 1) {
              err.write('consolidate --auto 的 --min-similarity 需要 0 到 1 之间的数（默认 0.62）\n');
              return 2;
            }
            minSimilarity = n;
          }
          let maxProposals;
          if (args['max-proposals'] !== undefined) {
            const n = numArg(args['max-proposals'], NaN);
            if (!Number.isInteger(n) || n < 1) {
              err.write('consolidate --auto 的 --max-proposals 需要正整数\n');
              return 2;
            }
            maxProposals = n;
          }
          if (args.write && args['dry-run']) {
            err.write('consolidate --auto 的 --write 和 --dry-run 只能选一个\n');
            return 2;
          }
          const r = sweepConsolidation(ctx, { dry: !args.write, minSimilarity, maxProposals });
          emit(r, { json, human: renderSweep(r) });
          return r.ok ? 0 : 1;
        }
        const contentModes = ['merge', 'summarize', 'promote'].map((name) => ({ name, ...flagArgValues(argv, args, name) }));
        const selectedModes = contentModes.filter((m) => m.provided);
        if (selectedModes.length > 0) {
          const archiveProbe = archiveArgValues(argv, args);
          if (selectedModes.some((m) => m.invalid)) {
            err.write(`consolidate --${selectedModes.find((m) => m.invalid).name} 需要源 id（可逗号分隔，也可重复）\n`);
            return 2;
          }
          if (selectedModes.length > 1) {
            err.write('consolidate --merge / --summarize / --promote 一次只能选一个\n');
            return 2;
          }
          if (archiveProbe.provided || args.undo !== undefined) {
            err.write('内容类提案不能和 --archive / --undo 同时用\n');
            return 2;
          }
          if (args.scope !== undefined || args.kinds !== undefined) {
            err.write('内容类巩固不接受 --scope / --kinds（这些是元数据巩固的参数）\n');
            return 2;
          }
          const chosen = selectedModes[0];
          const r = applyContentConsolidation(ctx, {
            mode: chosen.name,
            ids: chosen.values,
            apply,
            maxChangeRatio,
          });
          emit(r, { json, human: r.dry_run === false ? humanContentApply(r) : humanProposal(r) });
          return r.ok ? 0 : 1;
        }
        const archive = archiveArgValues(argv, args);
        if (archive.invalid) {
          err.write('consolidate --archive 需要 <id>（可逗号分隔，也可重复 --archive）\n');
          return 2;
        }
        const undoRef = typeof args.undo === 'string' ? args.undo : null;
        if (args.undo !== undefined) {
          if (!undoRef) {
            err.write('consolidate --undo 需要 <run_id|path>\n');
            return 2;
          }
          if (args.apply || args['dry-run'] || archive.provided) {
            err.write('consolidate --undo 不能和 --apply/--dry-run/--archive 同时用\n');
            return 2;
          }
          const peek = readAnyRunReceipt(ctx.store, undoRef);
          const r = peek.ok && peek.schema === CONTENT_RECEIPT_SCHEMA
            ? undoContentConsolidation(ctx, undoRef)
            : undoConsolidation(ctx, undoRef);
          emit(r, { json, human: humanUndo(r) });
          return r.ok ? 0 : 1;
        }
        const r = consolidate(ctx, {
          apply,
          maxChangeRatio,
          scope: args.scope,
          kinds: listArg(args.kinds),
          archive: archive.values,
        });
        emit(r, { json, human: humanConsolidate(r) });
        return r.ok ? 0 : 1;
      }
      case 'read': {
        const id = args.id ?? args._[1];
        if (!id) {
          err.write('read 需要 --id <file>\n');
          return 2;
        }
        const r = read(ctx, id, { withText: Boolean(args['with-text']) });
        if (args.ledger && r.ok) {
          ctx.ledger({ kind: 'opened', id: r.id, title: r.title, via: 'cli:read' });
        }
        const { ok, id: noteId, title, body, ...rest } = r;
        const frozen = { id: noteId, title, body };
        emit(json ? (ok ? { ...frozen, ok, ...rest } : { ok: false, ...frozen, reason: r.reason, errors: r.errors }) : r, {
          json,
          human: ok ? `# ${title}\n\n${body}` : `读不到 ${noteId}：${r.reason}`,
        });
        return ok ? 0 : 1;
      }
      case 'remember': {
        const file = args.file ?? args._[1];
        if (!file) {
          err.write('remember 需要 --file <path.md>（或 stdin，见 docs/07-usage.md）\n');
          return 2;
        }
        if (!existsSync(file)) {
          err.write(`文件不存在：${file}\n`);
          return 2;
        }
        const { readFileSync } = await import('node:fs');
        const text = readFileSync(file, 'utf8');
        const r = remember(ctx, { text }, {
          dry: Boolean(args.dry),
          force: Boolean(args.force),
          id: args.id,
          kind: args.kind,
          trust: args.trust,
          scope: args.scope,
          scopeDetail: args['scope-detail'] ?? args.scopeDetail,
          tags: listArg(args.tags) ?? [],
          writtenBy: args['written-by'] ?? 'cli:remember',
        });
        const frozen = { ok: r.ok, verdict: r.verdict, reason: r.reason };
        emit(json ? { ...frozen, id: r.id, gate: r.gate, status: r.status, path: r.path ?? null, would_write: r.would_write ?? null, details: r.details } : r, {
          json,
          human: renderRemember(r),
        });
        return r.ok ? 0 : 1;
      }

      case 'capture': {
        const file = args.file ?? args._[1];
        if (!file) {
          err.write('capture 需要 --file <path.md|->\n');
          return 2;
        }
        let text;
        if (file === '-') {
          text = await readAll(io.stdin ?? process.stdin);
        } else {
          if (!existsSync(file)) {
            err.write('文件不存在：' + file + '\n');
            return 2;
          }
          const { readFileSync } = await import('node:fs');
          text = readFileSync(file, 'utf8');
        }
        const result = addCandidate(ctx, { text, source: args.source }, {
          dry: Boolean(args.dry),
          force: Boolean(args.force),
          id: args.id,
          kind: args.kind,
          tags: listArg(args.tags) ?? [],
        });
        emit(result, { json, human: renderCapture(result) });
        return result.ok ? 0 : 1;
      }
      case 'inbox': {
        const accept = flagArgValues(argv, args, 'accept');
        const reject = flagArgValues(argv, args, 'reject');
        if (accept.invalid || reject.invalid) {
          err.write('inbox --accept/--reject 需要候选 id（可重复或逗号分隔）\n');
          return 2;
        }
        if (!accept.provided && !reject.provided) {
          const candidates = listCandidates(ctx);
          const proposals = listProposals(ctx);
          const result = {
            ...candidates,
            proposals: proposals.proposals,
            proposal_count: proposals.count,
            proposal_failures: proposals.failures,
          };
          emit(result, { json, human: renderInbox(result) });
          return 0;
        }
        const proposalIds = (ids) => ids.filter((id) => id.startsWith('prop_'));
        const candidateIds = (ids) => ids.filter((id) => !id.startsWith('prop_'));
        const acceptedIn = candidateIds(accept.values);
        const rejectedIn = candidateIds(reject.values);
        const acceptedProps = proposalIds(accept.values);
        const rejectedProps = proposalIds(reject.values);
        const results = [];
        if (acceptedIn.length || rejectedIn.length) {
          results.push(reviewCandidates(ctx, {
            accept: acceptedIn,
            reject: rejectedIn,
            dry: Boolean(args.dry),
            force: Boolean(args.force),
          }));
        }
        if (acceptedProps.length || rejectedProps.length) {
          results.push(reviewProposals(ctx, {
            accept: acceptedProps,
            reject: rejectedProps,
            dry: Boolean(args.dry),
          }));
        }
        const result = {
          ok: results.every((r) => r.ok),
          reason: results.map((r) => r.reason).filter(Boolean).join(',') || null,
          dry_run: Boolean(args.dry),
          accepted: results.flatMap((r) => r.accepted ?? []),
          rejected: results.flatMap((r) => r.rejected ?? []),
          failed: results.flatMap((r) => r.failed ?? []),
          accepted_count: results.reduce((n, r) => n + (r.accepted_count ?? 0), 0),
          rejected_count: results.reduce((n, r) => n + (r.rejected_count ?? 0), 0),
          failed_count: results.reduce((n, r) => n + (r.failed_count ?? 0), 0),
        };
        emit(result, { json, human: renderReview(result) });
        return result.ok ? 0 : 1;

      }
      case 'setup': {
        if (args.host === true || args.command === true || args['mcp-bin'] === true) {
          err.write('setup 的参数缺值：--host / --command / --mcp-bin\n');
          return 2;
        }
        const home = args.home ? resolve(String(args.home)) : homedir();
        const plan = planSetup({
          hosts: args.host ?? 'all',
          home,
          command: args.command ? String(args.command) : undefined,
          mcpBin: args['mcp-bin'] ? resolve(String(args['mcp-bin'])) : resolve(join(HERE, 'memory-mcp')),
          store: storePath,
          readOnly: Boolean(args['read-only']),
          force: Boolean(args.force),
        });
        if (!args.write) {
          const verification = args.verify && plan.ok ? verifyHosts({ hosts: plan.hosts.map((h) => h.host), home }) : null;
          const result = verification ? { ...plan, verification } : plan;
          const human = renderSetup(plan) + (verification ? '\n\n' + renderVerification(verification) : '');
          emit(result, { json, human });
          return plan.ok && (!verification || verification.ok) ? 0 : 1;
        }
        const applied = applySetup(plan);
        const verification = args.verify && plan.ok && applied.ok ? verifyHosts({ hosts: plan.hosts.map((h) => h.host), home }) : null;
        const result = { ...plan, dry_run: false, ...applied, ...(verification ? { verification } : {}) };
        const human = renderSetupApplied(plan, applied) + (verification ? '\n\n' + renderVerification(verification) : '');
        emit(result, { json, human });
        return applied.ok && (!verification || verification.ok) ? 0 : 1;
      }
      case 'schedule': {
        const sub = args._[1] ?? 'status';
        if (args.home === true || args.interval === true) {
          err.write('schedule 的参数缺值：--home / --interval\n');
          return 2;
        }
        if (!['install', 'uninstall', 'status'].includes(sub)) {
          err.write('schedule 需要 install / uninstall / status\n');
          return 2;
        }
        const platform = process.env.TABELLIO_SCHEDULE_PLATFORM || process.platform;
        const home = args.home ? resolve(String(args.home)) : homedir();
        if (sub === 'status') {
          const result = scheduleStatus({ platform, home });
          emit(result, { json, human: renderScheduleStatus(result) });
          return result.ok ? 0 : 1;
        }
        let intervalMinutes = SCHEDULE_DEFAULT_INTERVAL_MINUTES;
        if (args.interval !== undefined) {
          const parsed = parseIntervalMinutes(args.interval);
          if (parsed === null) {
            err.write('schedule --interval 需要 15m–7d 之间，例如 6h / 30m / 360\n');
            return 2;
          }
          intervalMinutes = parsed;
        }
        const plan = planScheduleInstall({
          platform,
          home,
          bin: resolve(join(HERE, 'memory')),
          store: storePath,
          command: process.execPath,
          intervalMinutes,
          uninstall: sub === 'uninstall',
          force: Boolean(args.force),
        });
        if (!args.write) {
          const result = { ...plan, dry_run: true };
          emit(result, { json, human: renderSchedulePlan(plan, true) });
          return plan.ok ? 0 : 1;
        }
        const applied = applyScheduleInstall(plan);
        const result = { ...plan, dry_run: false, ...applied };
        emit(result, { json, human: renderScheduleApplied(plan, applied) });
        return applied.ok ? 0 : 1;
      }
      case 'hook': {
        const sub = args._[1];
        if (args.host === true || args.home === true) {
          err.write('hook 的参数缺值：--host / --home\n');
          return 2;
        }
        if (sub === 'install' || sub === 'uninstall') {
          const plan = planHookInstall({
            host: args.host ?? 'claude',
            home: args.home ? resolve(String(args.home)) : homedir(),
            bin: resolve(join(HERE, 'memory')),
            store: storePath,
            command: process.execPath,
            uninstall: sub === 'uninstall',
            force: Boolean(args.force),
            sessionStart: Boolean(args['session-start']),
            autoConsolidate: Boolean(args['auto-consolidate']),
          });
          if (!args.write) {
            const result = { ...plan, dry_run: true };
            emit(result, { json, human: renderHookPlan(plan, true) });
            return plan.ok ? 0 : 1;
          }
          const applied = applyHookInstall(plan);
          const result = { ...plan, dry_run: false, ...applied };
          emit(result, { json, human: renderHookApplied(plan, applied) });
          return applied.ok ? 0 : 1;
        }
        if (sub === 'claude-session-end') {
          // 宿主钩子：读 stdin 的 SessionEnd 事件。任何失败都退 0——钩子不该阻塞宿主退出。
          let event;
          try {
            event = JSON.parse(await readAll(io.stdin ?? process.stdin));
          } catch {
            if (json) out.write(JSON.stringify({ ok: false, reason: 'invalid_event' }) + '\n');
            return 0;
          }
          const transcriptPath = typeof event?.transcript_path === 'string' ? event.transcript_path : null;
          if (!transcriptPath) {
            if (json) out.write(JSON.stringify({ ok: false, reason: 'transcript_path_missing' }) + '\n');
            return 0;
          }
          if (!existsSync(transcriptPath)) {
            if (json) out.write(JSON.stringify({ ok: false, reason: 'transcript_missing', transcript_path: transcriptPath }) + '\n');
            return 0;
          }
          let transcript;
          try {
            transcript = readFileSync(transcriptPath, 'utf8');
          } catch (e) {
            if (json) out.write(JSON.stringify({ ok: false, reason: 'transcript_unreadable', error: String(e?.message ?? e) }) + '\n');
            return 0;
          }
          const extracted = extractMemoryCandidates(transcript);
          const sessionId =
            typeof event?.session_id === 'string'
              ? event.session_id
              : extracted.candidates.find((c) => c.session_id)?.session_id ?? null;
          const source = 'claude:session-end:' + (sessionId ?? 'unknown');
          const captured = [];
          const rejected = [];
          let storeError = null;
          let proposalStats = null;
          let proposalError = null;
          const wantsSweep = Boolean(args['auto-consolidate']);
          let hookCtx = null;
          if (extracted.candidates.length > 0) {
            try {
              hookCtx = openStore(storePath);
              for (const candidate of extracted.candidates) {
                const r = addCandidate(
                  hookCtx,
                  { text: candidate.body, source, tags: ['hook', 'claude'], kind: 'semantic' },
                  { writtenBy: 'capture:hook' },
                );
                if (r.ok) captured.push({ id: r.id, title: r.title, chars: r.chars });
                else rejected.push({ reason: r.reason, ...(r.duplicate_of ? { duplicate_of: r.duplicate_of } : {}) });
              }
            } catch (e) {
              // 钩子不能因为 store 损坏/没权限就阻塞宿主退出；失败如实报，但退出码仍是 0。
              storeError = String(e?.message ?? e);
            }
          }
          if (wantsSweep) {
            try {
              hookCtx = hookCtx ?? openStore(storePath);
              const swept = sweepConsolidation(hookCtx, { dry: false });
              proposalStats = {
                discovered: swept.discovered,
                created: swept.created_count,
                existing: swept.existing_count,
                failed: swept.failed_count,
              };
              if (!swept.ok) proposalError = 'proposal_partial_failure';
            } catch (e) {
              // 自动发现失败不阻塞宿主退出，也不影响已经收下的候选。
              proposalError = String(e?.message ?? e);
            }
          }
          const result = {
            ok: storeError === null && proposalError === null,
            event: 'SessionEnd',
            ...(storeError ? { reason: 'store_write_failed', error: storeError } : { reason: typeof event?.reason === 'string' ? event.reason : null }),
            ...(proposalError ? { proposal_error: proposalError } : {}),
            session_id: sessionId,
            captured,
            rejected,
            ...(proposalStats ? { proposals: proposalStats } : {}),
            stats: extracted.stats,
            truncated: extracted.truncated,
          };
          if (json) out.write(JSON.stringify(result) + '\n');
          return 0;
        }
        if (sub === 'claude-session-start') {
          // 宿主钩子：只读候选数、输出提示。任何失败都退 0——提示不该阻塞会话开始。
          let event;
          try {
            event = JSON.parse(await readAll(io.stdin ?? process.stdin));
          } catch {
            if (json) out.write(JSON.stringify({ ok: false, reason: 'invalid_event' }) + '\n');
            return 0;
          }
          let candidateCount;
          let proposalCount;
          try {
            // 库路径存在但不是目录，是明确的配置错误；不要静默当成「没有候选」。
            if (existsSync(storePath) && !statSync(storePath).isDirectory()) throw new Error('store 不是目录：' + storePath);
            const hookCtx = openStore(storePath);
            candidateCount = listCandidates(hookCtx).count;
            proposalCount = listProposals(hookCtx).count;
          } catch (e) {
            if (json) out.write(JSON.stringify({ ok: false, reason: 'store_unreadable', error: String(e?.message ?? e) }) + '\n');
            return 0;
          }
          const parts = [];
          if (candidateCount > 0) parts.push(candidateCount + ' 条候选');
          if (proposalCount > 0) parts.push(proposalCount + ' 条自动巩固提案');
          const additionalContext =
            parts.length > 0
              ? '[tabellio] 有 ' + parts.join('、') + '待确认。运行 `tabellio inbox` 查看；批准用 `tabellio inbox --accept <id>`。'
              : null;
          if (json) {
            out.write(
              JSON.stringify({
                ok: true,
                event: 'SessionStart',
                source: typeof event?.source === 'string' ? event.source : null,
                candidates: candidateCount,
                proposals: proposalCount,
                prompted: additionalContext !== null,
                ...(additionalContext ? { additionalContext } : {}),
              }) + '\n',
            );
            return 0;
          }
          if (additionalContext) {
            out.write(JSON.stringify({ hookSpecificOutput: { hookEventName: 'SessionStart', additionalContext } }) + '\n');
          }
          return 0;
        }
        err.write('hook 需要 install / uninstall / claude-session-end / claude-session-start\n');
        return 2;
      }
      case 'import': {
        const from = args.from ?? args._[1];
        if (!from) {
          err.write('import 需要 --from <旧 Engramory 库目录>\n');
          return 2;
        }
        const srcDir = resolve(String(from));
        if (!existsSync(srcDir)) {
          err.write(`源目录不存在：${srcDir}\n`);
          return 2;
        }
        if (!args.dry) ctx.ensure();
        const src = readSourceIndex(srcDir);
        const r = importFrom(ctx, srcDir, { dry: Boolean(args.dry), force: Boolean(args.force) });
        emit(r, { json, human: renderImport(r, src) });
        return r.ok ? 0 : 1;
      }
      default:
        err.write(`未知命令：${command}\n`);
        return 2;
    }
  } catch (e) {
    err.write(`tabellio ${command} 失败：${e?.stack ?? e}\n`);
    return 2;
  }
}


/** 读完整 stdin（capture --file -）。 */
async function readAll(stream) {
  let text = '';
  stream.setEncoding?.('utf8');
  for await (const chunk of stream) text += chunk;
  return text;
}

function renderCapture(r) {
  if (r.ok) {
    const head = (r.dry_run ? '[dry-run] ' : '') + (r.dry_run ? '会收成候选：' : '已收成候选：') + r.id;
    return [
      head,
      '标题：' + r.title,
      '来源：' + (r.source ?? '（未标注）'),
      '字数：' + r.chars,
      r.dry_run ? '会写：' + r.would_write : '路径：' + r.path,
      '下一步：tabellio inbox --accept ' + r.id,
    ].join('\n');
  }
  const reasons = {
    empty: '正文为空',
    too_large: '正文超过单条 8KB 上限',
    invalid_id: 'id 不合法',
    id_exists: 'id 已存在',
    duplicate: '和已有内容重复',
    store_write_failed: '落盘失败',
  };
  let line = '候选未写入：' + (reasons[r.reason] ?? r.reason);
  if (r.duplicate_of) line += '（已存在：' + r.duplicate_of.kind + ' ' + r.duplicate_of.id + '）';
  return line;
}

function renderSweep(r) {
  const head = r.dry_run
    ? '[dry-run] 自动发现：扫描 ' + r.scanned + ' 条，找到 ' + r.discovered + ' 组近似重复；没有写任何文件'
    : '自动发现：扫描 ' + r.scanned + ' 条，发现 ' + r.discovered + ' 组；新提案 ' + r.created_count + ' 条，已有 ' + r.existing_count + ' 条';
  const lines = [head];
  for (const item of r.items ?? []) {
    const saved = item.estimated_saved_tokens === null ? '?' : item.estimated_saved_tokens;
    lines.push('  [' + item.id + '] ' + item.source_count + ' 条近似重复（最低重叠 ' + item.similarity + '，预计省 ' + saved + ' token）');
    lines.push('    源：' + (item.source_titles ?? []).join(' / '));
  }
  for (const f of r.failed ?? []) lines.push('  ! ' + (f.proposal_id ?? f.id ?? '?') + '：' + (f.reason ?? '失败'));
  if (r.truncated) lines.push('  … 还有 ' + r.skipped + ' 组超过本轮上限，下次再处理');
  if (!r.dry_run && (r.created_count ?? 0) > 0) lines.push('下一步：tabellio inbox 查看；批准：tabellio inbox --accept <prop_id>');
  if (r.dry_run) lines.push('要落成待确认提案，加 --write。');
  return lines.join('\n');
}

function renderInbox(r) {
  const candidateCount = r.count ?? 0;
  const proposalCount = r.proposal_count ?? 0;
  if (candidateCount === 0 && proposalCount === 0) {
    return '候选箱是空的。用 tabellio capture --file - 把候选丢进来，批准后才进主库；\n自动巩固提案会在 tabellio consolidate --auto --write 后出现在这里。';
  }
  const lines = [];
  if (candidateCount > 0) {
    lines.push('候选 ' + candidateCount + ' 条（notes/candidates，默认不进检索面）：');
    for (const c of r.candidates) {
      lines.push('  [' + c.id + '] ' + c.title + ' — ' + (c.source ?? '（无来源）') + ' / ' + c.chars + ' 字' + (c.created ? ' / ' + c.created : ''));
    }
  }
  if (proposalCount > 0) {
    if (lines.length) lines.push('');
    lines.push('自动巩固提案 ' + proposalCount + ' 条（只待确认，未改任何笔记）：');
    for (const p of r.proposals) {
      const saved = p.estimated_saved_tokens === null ? '?' : p.estimated_saved_tokens;
      lines.push('  [' + p.id + '] ' + p.source_count + ' 条近似重复（重叠 ' + p.similarity + '，预计省 ' + saved + ' token）');
      lines.push('    源：' + (p.source_titles ?? []).join(' / '));
    }
  }
  for (const f of r.proposal_failures ?? []) lines.push('  ! 提案读取失败：' + (f.path ?? f.id ?? '?') + ' — ' + (f.reason ?? '未知错误'));
  lines.push('批准：tabellio inbox --accept <id>   拒绝：--reject <id>（两类 id 都能直接填）');
  return lines.join('\n');
}

function renderReview(r) {
  const lines = [r.dry_run ? '[dry-run] 只预览，不落盘' : '处理完成'];
  for (const a of r.accepted) {
    const isProposal = String(a.id).startsWith('prop_');
    if (isProposal) {
      if (a.status === 'planned') lines.push('  ✓ 批准提案 ' + a.id + '（会合并，未落盘）');
      else lines.push('  ✓ 批准提案 ' + a.id + '（已合并，run ' + (a.run_id ?? '?') + '，目标是 ' + (a.target_id ?? '?') + '）');
    } else {
      lines.push('  ✓ 批准 ' + a.id + (a.status === 'planned' ? '（会入库）' : '（已入库）'));
    }
  }
  for (const x of r.rejected) lines.push('  ✗ 拒绝 ' + x.id);
  for (const f of r.failed) {
    const why = f.reason === 'proposal_stale' ? '提案过期（源已被改动）' : (f.reason ?? '失败');
    lines.push('  ! ' + f.id + '：' + why + (f.note_stored ? '（笔记已入库，但候选归档失败）' : ''));
  }
  lines.push('批准 ' + r.accepted_count + ' / 拒绝 ' + r.rejected_count + ' / 失败 ' + r.failed_count);
  return lines.join('\n');
}


function renderVerification(v) {
  const mark = { connected: '✓', configured: '=', unverified: '?', unavailable: '-', failed: '!', missing: '!' };
  const label = {
    connected: '已连接',
    configured: '配置已接受（未做连接检查）',
    unverified: '未验证',
    unavailable: '宿主 CLI 未找到',
    failed: '验证失败',
    missing: '配置未生效',
  };
  const lines = ['验证（宿主自己的视角）：'];
  for (const h of v.hosts) {
    lines.push('  ' + (mark[h.level] ?? '?') + ' ' + h.label + '：' + (label[h.level] ?? h.level) + (h.detail ? ' — ' + h.detail : ''));
  }
  if (!v.ok) lines.push('有宿主明确失败：配置已写，但宿主没连上。');
  return lines.join('\n');
}

function renderSetup(plan) {
  if (!plan.ok) {
    const reasons = {
      no_host_detected: '没检测到已安装的 Claude Code / Cursor / Codex CLI（可用 --host 显式指定）',
      conflict: '已有不同的 tabellio 配置；确认要替换请加 --force',
      invalid_config: '有配置文件解析失败；整单未写入（先手工修好 JSON）',
      unknown_host: '不认识的宿主：' + (plan.unknown ?? ''),
      missing_target: '缺少 mcpBin / store',
    };
    const lines = ['setup 未执行：' + (reasons[plan.reason] ?? plan.reason)];
    for (const h of plan.hosts ?? []) {
      lines.push('- ' + h.label + ' ' + h.path + '：' + h.action + (h.error ? '（' + h.error.message + '）' : ''));
    }
    return lines.join('\n');
  }
  const lines = ['[dry-run] 将处理 ' + plan.hosts.length + ' 个宿主（加 --write 才落盘）'];
  for (const h of plan.hosts) {
    lines.push('- ' + h.label + ' ' + h.path + '：' + h.action + (h.backup ? '（备份 ' + h.backup + '）' : ''));
  }
  lines.push('MCP server：' + plan.server.command + ' ' + plan.server.args.join(' '));
  return lines.join('\n');
}

function renderSetupApplied(plan, applied) {
  if (!applied.ok) {
    const lines = ['setup 未完全成功：'];
    for (const f of applied.failed) lines.push('  ! ' + f.host + '：' + f.error);
    return lines.join('\n');
  }
  const lines = ['setup 完成'];
  for (const a of applied.applied) {
    lines.push('  ' + (a.written ? '✓ 写入 ' : '= 未变 ') + a.host + '：' + a.path + (a.backup ? '（备份 ' + a.backup + '）' : ''));
  }
  return lines.join('\n');
}

function hookEventLabel(event) {
  return event === 'session-start' ? '会话开始' : event === 'session-end' ? '会话结束' : String(event ?? '钩子');
}

function renderHookPlan(plan, dryRun) {
  const actionLabel = {
    create: '新建配置',
    append: '追加到已有配置',
    update: '替换已有的 tabellio 钩子',
    unchanged: '已经是目标配置，无需改动',
    uninstall: '移除 tabellio 钩子',
    conflict: '已有指向别处的 tabellio 钩子',
    invalid: '配置无法安全解析',
    unsupported: '不支持的宿主',
  };
  const lines = [];
  if (!plan.ok) {
    const reasons = {
      unknown_host: '只支持 Claude Code（--host claude）',
      conflict: '已有指向别处的 tabellio 钩子；确认替换请加 --force',
      invalid_config: 'settings.json 解析失败或结构不认识；整份未写入',
      missing_target: '缺少可执行文件或 store 路径',
    };
    lines.push('钩子未安装：' + (reasons[plan.reason] ?? plan.reason));
    if (plan.event) lines.push('事件：' + hookEventLabel(plan.event));
    if (plan.path) lines.push('配置：' + plan.path);
    if (plan.error?.message) lines.push('原因：' + plan.error.message);
    return lines.join('\n');
  }
  const details = Array.isArray(plan.events) ? plan.events : [];
  const active = details.filter((item) => item.action !== 'unchanged');
  const scope = active.length ? '（' + active.map((item) => hookEventLabel(item.event)).join(' + ') + '）' : '';
  lines.push((dryRun ? '[dry-run] ' : '') + 'Claude Code 钩子' + scope + '：' + (actionLabel[plan.action] ?? plan.action));
  lines.push('配置：' + plan.path);
  if (plan.action === 'uninstall') {
    lines.push('将移除 ' + plan.removed + ' 条 tabellio 钩子');
    for (const item of active) lines.push('  - ' + hookEventLabel(item.event) + '：' + item.removed + ' 条');
  } else if (plan.action !== 'unchanged') {
    for (const item of active) {
      if (!item.desired) continue;
      lines.push('  - ' + hookEventLabel(item.event) + '：' + item.desired.command + ' ' + item.desired.args.join(' '));
    }
    lines.push('超时：' + (plan.desired?.timeout ?? 15) + ' 秒');
  }
  if (plan.backup) lines.push('写前备份：' + plan.backup);
  if (dryRun) lines.push('加 --write 才落盘。');
  return lines.join('\n');
}

function renderHookApplied(plan, applied) {
  if (!applied.ok) {
    const reasons = {
      conflict: '已有指向别处的 tabellio 钩子；确认替换请加 --force',
      invalid_config: 'settings.json 解析失败或结构不认识；整份未写入',
      invalid_plan: '计划本身不成立，未写入',
      missing_preview: '内部错误：没有可写入的内容',
      write_failed: '写入失败',
    };
    const lines = ['钩子未写入：' + (reasons[applied.reason] ?? applied.reason)];
    if (applied.error) lines.push('原因：' + applied.error);
    return lines.join('\n');
  }
  if (!applied.written) return '没有改动：' + (plan.path ?? '');
  if (plan.action === 'uninstall') {
    return [
      '已移除 ' + plan.removed + ' 条 tabellio 钩子：' + applied.path,
      ...(applied.backup ? ['写前备份：' + applied.backup] : []),
    ].join('\n');
  }
  const events = (plan.events ?? []).filter((item) => item.action !== 'unchanged').map((item) => hookEventLabel(item.event));
  const lines = [
    '钩子已写入：' + applied.path,
    ...(applied.backup ? ['写前备份：' + applied.backup] : []),
    '已安装：' + (events.join(' + ') || '会话结束'),
  ];
  if (events.includes('会话开始')) lines.push('下次 Claude Code 会话开始时会提示待批准候选数；批准仍走 tabellio inbox。');
  if (events.includes('会话结束')) lines.push('下次 Claude Code 会话结束后会自动生成候选；用 tabellio inbox 查看/批准。');
  return lines.join('\n');
}

function scheduleIntervalLabel(minutes) {
  if (!Number.isFinite(minutes)) return '?';
  if (minutes % 1440 === 0) return minutes / 1440 + ' 天';
  if (minutes % 60 === 0) return minutes / 60 + ' 小时';
  return minutes + ' 分钟';
}

function renderSchedulePlan(plan, dryRun) {
  const reasons = {
    unsupported_platform: '定时自动发现目前只支持 macOS',
    missing_target: '缺少可执行文件或 store 路径',
    invalid_path: 'bin / store 必须是绝对路径',
    invalid_command: 'Node 必须是绝对路径',
    invalid_interval: '间隔超出范围（15 分钟到 7 天）',
    conflict: '已有另一个 tabellio 定时任务；确认替换请加 --force',
    E_SCHEDULE_UNREADABLE: '已有 plist 无法读取',
    invalid_plan: '计划本身不成立',
  };
  if (!plan.ok) {
    const lines = ['定时任务未安装：' + (reasons[plan.reason] ?? plan.reason)];
    if (plan.path) lines.push('plist：' + plan.path);
    if (plan.hint) lines.push(plan.hint);
    return lines.join('\n');
  }
  const actionLabel = {
    create: '新建 LaunchAgent',
    update: '替换已有 LaunchAgent',
    unchanged: '已是最新配置',
    uninstall: '移除 LaunchAgent',
  };
  const lines = [(dryRun ? '[dry-run] ' : '') + '定时自动发现：' + (actionLabel[plan.action] ?? plan.action)];
  lines.push('plist：' + plan.path);
  if (plan.action === 'uninstall') {
    lines.push('将移除 ' + plan.path + '，并尝试从 launchd 卸载 ' + plan.label);
    if (dryRun) lines.push('加 --write 才移除。');
    return lines.join('\n');
  }
  if (plan.action === 'unchanged') {
    lines.push('内容没有变化；加 --write 会确认/尝试加载。');
    return lines.join('\n');
  }
  lines.push('间隔：每 ' + scheduleIntervalLabel(plan.interval_minutes));
  lines.push('库：' + plan.store);
  lines.push('命令：' + plan.program_arguments.join(' '));
  lines.push('日志：' + plan.out_log + ' / ' + plan.err_log);
  if (plan.backup) lines.push('写前备份：' + plan.backup);
  lines.push('它只跑 consolidate --auto --write：只写待批准提案，不会合并、批准或改笔记。');
  if (dryRun) lines.push('加 --write 才写入并加载到 launchd。');
  return lines.join('\n');
}

function renderScheduleApplied(plan, applied) {
  if (!applied.ok) {
    const reasons = {
      load_failed: 'plist 已写入，但 launchd 没有加载',
      launchctl_unavailable: '找不到 launchctl，无法加载',
      no_uid: '拿不到当前用户 uid',
      write_failed: 'plist 写入失败',
      remove_failed: 'plist 移除失败',
      invalid_plan: '计划本身不成立',
      missing_preview: '内部错误：没有可写入的内容',
      conflict: '已有另一个 tabellio 定时任务；确认替换请加 --force',
    };
    const lines = ['定时任务未生效：' + (reasons[applied.reason] ?? applied.reason)];
    if (applied.written) lines.push('plist 已写入：' + applied.path);
    if (applied.error) lines.push('原因：' + applied.error);
    if (applied.hint) lines.push(applied.hint);
    return lines.join('\n');
  }
  if (plan.action === 'uninstall') {
    return [
      '已移除定时任务：' + applied.path,
      applied.unloaded ? 'launchd 已卸载。' : 'launchd 里本来就没有加载这个任务。',
    ].join('\n');
  }
  if (!applied.written) {
    return applied.loaded ? '配置已是最新，launchd 里已加载：' + applied.path : '配置已是最新：' + applied.path;
  }
  const lines = [
    '定时任务已安装：' + applied.path,
    '间隔：每 ' + scheduleIntervalLabel(plan.interval_minutes),
    '库：' + plan.store,
    applied.loaded ? 'launchd：已加载，下次到点会运行。' : 'launchd：未加载。',
    '日志：' + plan.out_log,
  ];
  lines.push('它只写待批准提案；用 tabellio inbox 查看，批准仍要你点名。');
  return lines.join('\n');
}

function renderScheduleStatus(r) {
  if (!r.supported) {
    return [
      '当前平台（' + r.platform + '）不支持定时自动发现。',
      '目前只支持 macOS launchd；Linux 可先用 cron 手动跑 tabellio consolidate --auto --write。',
    ].join('\n');
  }
  if (!r.installed) {
    return [
      '没有安装定时任务。',
      '安装：tabellio schedule install --write（默认每 6 小时；只产提案）',
    ].join('\n');
  }
  const loadState = r.checked ? (r.loaded ? '已加载' : '未加载') : '无法检查（' + (r.error ?? 'launchctl 不可用') + '）';
  const lines = [
    '定时任务：已安装',
    'plist：' + r.path,
    'launchd：' + loadState,
  ];
  if (r.interval_minutes !== null) lines.push('间隔：每 ' + scheduleIntervalLabel(r.interval_minutes));
  if (r.store) lines.push('库：' + r.store);
  lines.push('日志：' + r.out_log);
  if (r.checked && !r.loaded && r.detail) lines.push('launchd 说：' + r.detail);
  return lines.join('\n');
}

function renderRemember(r) {
  const head = `判定：${r.gate ?? r.verdict}  status=${r.status}  reason=${r.reason}`;
  const lines = [head, `id：${r.id}`];
  if (r.would_write) lines.push(`--dry：会写 ${r.would_write}`);
  if (r.path) lines.push(`已写入：${r.path}（${r.bytes} 字节）`);
  if (r.details) {
    const d = r.details;
    const bits = [];
    if (d.chars !== undefined) bits.push(`${d.chars} 字`);
    if (d.tokens !== undefined) bits.push(`${d.tokens} token`);
    if (d.mode) bits.push(`mode=${d.mode}`);
    if (d.shrinkEscape) bits.push('缩小重写放行');
    if (bits.length) lines.push(`测量：${bits.join(' / ')}`);
    if (d.suggestion) lines.push(`建议：${d.suggestion}`);
    if (d.why) lines.push(`原因：${d.why}`);
  }
  if (r.index) lines.push(`索引：${r.index.lines} 行${r.index.truncated ? '（截断）' : ''}`);
  return lines.join('\n');
}

function renderImport(r, src) {
  const lines = [
    `${r.dry ? '[dry-run] ' : ''}源：${r.source}`,
    `源索引：${src.exists ? `${src.path}` : '（没有 MEMORY.md）'}`,
    `计划 ${r.planned} 条：新建 ${r.imported} / 更新 ${r.updated} / 未变跳过 ${r.skipped} / 被拒 ${r.denied} / 源文件读不了 ${r.failures}`,
    `源索引指针 ${r.indexPointers} 行${r.badIndexLines ? `，坏指针行 ${r.badIndexLines}` : ''}`,
  ];
  if (r.denied_files.length) {
    lines.push('被闸门拒掉的：');
    for (const d of r.denied_files.slice(0, 20)) lines.push(`  - ${d.file}：${d.reason}`);
  }
  if (r.not_imported.length) {
    lines.push('没导入的源文件：');
    for (const f of r.not_imported.slice(0, 20)) lines.push(`  - ${f.file}：${f.code}`);
  }
  return lines.join('\n');
}

/** 只有被直接执行时才跑 CLI（被测试 import 时不跑）。 */
// 必须比 realpath：npm 装出来的 `tabellio` 是 node_modules/.bin/ 下的**符号链接**，
// 此时 process.argv[1] 是链接路径、而 import.meta.url 已被 Node 解析成真实文件路径，
// 直接比 resolve() 永远不相等 —— 装完的 CLI 会静默什么都不做、退出码还是 0。
const realOrSelf = (p) => {
  try {
    return realpathSync(p);
  } catch {
    return resolve(p);
  }
};
const invokedDirectly =
  !!process.argv[1] &&
  realOrSelf(process.argv[1]) === realOrSelf(fileURLToPath(import.meta.url));
if (invokedDirectly) {
  const code = await main(process.argv.slice(2));
  process.exitCode = code;
}

export { INDEX_CAPS, STORE_CAPS, MAX_NOTE_CHARS, MAX_NOTE_TOKENS, VERSION, HERE };
